# What .env (gitignored) holds, for local dev and for scripts/. The Worker reads the same
# names from `wrangler secret put`, not from this file.

# Yours to fill in. The environment is the only one any script will touch.
DEMO_ENVIRONMENT_ID=
CONFLUENT_GLOBAL_KEY=
CONFLUENT_GLOBAL_SECRET=
ANTHROPIC_API_KEY=

# Written by scripts/bootstrap.sh.
DEMO_ORGANIZATION_ID=
DEMO_CLUSTER_ID=
DEMO_SERVICE_ACCOUNT=
DEMO_FLINK_POOL_ID=
CONFLUENT_REST_ENDPOINT=
CONFLUENT_BOOTSTRAP=
CONFLUENT_KAFKA_KEY=
CONFLUENT_KAFKA_SECRET=
CONFLUENT_SR_ENDPOINT=
CONFLUENT_SR_KEY=
CONFLUENT_SR_SECRET=
CONFLUENT_SQL_ENDPOINT=https://sql.us-east-1.aws.confluent.cloud/query/v1
RTCE_MCP_URL=
DEMO_GATE_PROD=

# Written by scripts/regenerate.sh when it registers the events schema.
RAW_EVENTS_SCHEMA_ID=

# Only for terraform/, which the first account used and a shared one does not.
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=
TF_VAR_environment_id=
TF_VAR_cluster_id=
