{
  "name": "gen-onboarding",
  "config": {
    "connector.class": "DatagenSource",
    "name": "gen-onboarding",
    "kafka.auth.mode": "KAFKA_API_KEY",
    "kafka.topic": "raw_trades",
    "output.data.format": "AVRO",
    "tasks.max": "1",
    "max.interval": "4000",
    "schema.string": "{\"type\":\"record\",\"name\":\"Trade\",\"namespace\":\"demo.raw\",\"fields\":[{\"name\":\"acct\",\"type\":{\"type\":\"int\",\"arg.properties\":{\"range\":{\"min\":14000,\"max\":17999}}}},{\"name\":\"sym\",\"type\":{\"type\":\"string\",\"arg.properties\":{\"options\":[\"ESU6\",\"NQZ6\",\"RTYZ6\"]}}},{\"name\":\"qty\",\"type\":{\"type\":\"int\",\"arg.properties\":{\"range\":{\"min\":20,\"max\":400}}}},{\"name\":\"px\",\"type\":{\"type\":\"double\",\"arg.properties\":{\"range\":{\"min\":5400.0,\"max\":5425.0}}}}]}"
  }
}
