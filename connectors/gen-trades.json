{
  "name": "gen-trades",
  "config": {
    "connector.class": "DatagenSource",
    "name": "gen-trades",
    "kafka.auth.mode": "KAFKA_API_KEY",
    "kafka.topic": "raw_trades",
    "output.data.format": "AVRO",
    "tasks.max": "1",
    "max.interval": "1500",
    "schema.string": "{\"type\":\"record\",\"name\":\"Trade\",\"namespace\":\"demo.raw\",\"fields\":[{\"name\":\"acct\",\"type\":{\"type\":\"int\",\"arg.properties\":{\"range\":{\"min\":10000,\"max\":13999}}}},{\"name\":\"sym\",\"type\":{\"type\":\"string\",\"arg.properties\":{\"options\":[\"ESU6\",\"NQZ6\",\"RTYZ6\"]}}},{\"name\":\"qty\",\"type\":{\"type\":\"int\",\"arg.properties\":{\"range\":{\"min\":-400,\"max\":400}}}},{\"name\":\"px\",\"type\":{\"type\":\"double\",\"arg.properties\":{\"range\":{\"min\":5400.0,\"max\":5425.0}}}}]}"
  }
}
